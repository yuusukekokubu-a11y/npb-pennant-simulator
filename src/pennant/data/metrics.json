  "baseline_names": {
    "w_bb": "四球の重み",
    "w_hbp": "死球の重み",
    "w_1b": "単打の重み",
    "w_2b": "二塁打の重み",
    "w_3b": "三塁打の重み",
    "w_hr": "本塁打の重み",
    "woba_scale": "wOBA の目盛り",
    "lg_obp": "リーグの出塁率",
    "lg_slg": "リーグの長打率",
    "lg_woba": "リーグの wOBA",
    "lg_r_pa": "リーグの1打席あたりの得点",
    "lg_era": "リーグの防御率",
    "fip_hr": "本塁打の係数",
    "fip_bb": "四死球の係数",
    "fip_so": "三振の係数",
    "fip_constant": "FIP 定数",
    "pf": "球場補正"
  },
  "metrics": {
    "avg": {
      "name": "打率",
      "formulas": {
        "batter": "H / AB"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "H",
        "AB"
      ],
      "stage": 1,
      "category": "basic"
    },
    "obp": {
      "name": "出塁率",
      "formulas": {
        "batter": "(H + BB + HBP) / (AB + BB + HBP + SF)"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "H",
        "BB",
        "HBP",
        "AB",
        "SF"
      ],
      "stage": 1,
      "category": "basic"
    },
    "slg": {
      "name": "長打率",
      "formulas": {
        "batter": "TB / AB"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "TB",
        "AB"
      ],
      "stage": 1,
      "category": "basic"
    },
    "ops": {
      "name": "OPS",
      "formulas": {
        "batter": "obp + slg"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "H",
        "BB",
        "HBP",
        "AB",
        "SF",
        "TB"
      ],
      "stage": 1,
      "category": "basic"
    },
    "iso": {
      "name": "ISO",
      "formulas": {
        "batter": "slg - avg"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "TB",
        "H",
        "AB"
      ],
      "stage": 1,
      "category": "saber"
    },
    "babip": {
      "name": "BABIP",
      "formulas": {
        "batter": "(H - HR) / (AB - SO - HR + SF)"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "H",
        "HR",
        "AB",
        "SO",
        "SF"
      ],
      "stage": 1,
      "category": "saber"
    },
    "k_pct": {
      "name": "K%",
      "formulas": {
        "batter": "SO / PA",
        "pitcher": "SO / BF"
      },
      "better": {
        "batter": "low",
        "pitcher": "high"
      },
      "format": "percent1",
      "inputs": [
        "SO",
        "PA",
        "BF"
      ],
      "stage": 1,
      "category": "saber"
    },
    "bb_pct": {
      "name": "BB%",
      "formulas": {
        "batter": "BB / PA",
        "pitcher": "BB / BF"
      },
      "better": {
        "batter": "high",
        "pitcher": "low"
      },
      "format": "percent1",
      "inputs": [
        "BB",
        "PA",
        "BF"
      ],
      "stage": 1,
      "category": "saber"
    },
    "woba": {
      "name": "wOBA",
      "formulas": {
        "batter": "(w_bb * BB + w_hbp * HBP + w_1b * B1 + w_2b * B2 + w_3b * B3 + w_hr * HR) / (AB + BB + HBP + SF)"
      },
      "better": {
        "batter": "high"
      },
      "format": "rate3",
      "inputs": [
        "BB",
        "HBP",
        "B1",
        "B2",
        "B3",
        "HR",
        "AB",
        "SF"
      ],
      "stage": 2,
      "category": "saber"
    },
    "wrc_plus": {
      "name": "wRC+",
      "formulas": {
        "batter": "((woba - lg_woba) / woba_scale + lg_r_pa + (lg_r_pa - pf * lg_r_pa)) / lg_r_pa * 100"
      },
      "better": {
        "batter": "high"
      },
      "format": "integer",
      "inputs": [
        "BB",
        "HBP",
        "B1",
        "B2",
        "B3",
        "HR",
        "AB",
        "SF"
      ],
      "stage": 2,
      "category": "saber"
    },
    "ops_plus": {
      "name": "OPS+",
      "formulas": {
        "batter": "100 * (obp / lg_obp + slg / lg_slg - 1) / pf"
      },
      "better": {
        "batter": "high"
      },
      "format": "integer",
      "inputs": [
        "H",
        "BB",
        "HBP",
        "AB",
        "SF",
        "TB"
      ],
      "stage": 2,
      "category": "saber"
    },
    "era": {
      "name": "防御率",
      "formulas": {
        "pitcher": "ER * 27 / OUTS"
      },
      "better": {
        "pitcher": "low"
      },
      "format": "decimal2",
      "inputs": [
        "ER",
        "OUTS"
      ],
      "stage": 1,
      "category": "basic"
    },
    "fip": {
      "name": "FIP",
      "formulas": {
        "pitcher": "(fip_hr * HR + fip_bb * (BB + HBP) - fip_so * SO) * 3 / OUTS + fip_constant"
      },
      "better": {
        "pitcher": "low"
      },
      "format": "decimal2",
      "inputs": [
        "HR",
        "BB",
        "HBP",
        "SO",
        "OUTS"
      ],
      "stage": 2,
      "category": "saber"
    }
  }
}
